+    }
+    checks.insert("exact_state_and_unrelated_invariants".into(), json!(after == expected));
+    checks.insert("never_played_or_recorded".into(), json!(no_play_or_record(run.requests) && !EVER_PLAYING_OR_RECORDING.with(Cell::get)));
+    checks.insert("no_unrequested_memories".into(), json!(goal.kind == 3 || (run.notes.is_empty() && run.producer_memory.is_null())));
+    checks.insert(
+        "no_unrequested_artifacts".into(),
+        json!(run.recipes.is_empty() && run.techniques.is_empty() && run.gaps.is_empty() && run.heard.is_empty()),
+    );
+    let passed = checks.values().all(|value| value == true);
+    VERIFICATION.with(|stored| *stored.borrow_mut() = json!({
+        "passed":passed,"checks":checks,"before":before,"after":after,
+        "verifier":"independent_synthetic_ableton_state_and_actual_readback",
+        "real_live_verified":false,"audio_quality_verified":false,
+        "changes":run.changes,"producer_memory_readback":run.producer_memory,"turn_checkpoints":TURN_CHECKPOINTS.with(|stored| stored.borrow().clone()),
+        "memory_events":run.notes.iter().map(|note| json!({"scope":if note.scope == MemoryScope::Producer {"producer"} else {"set"},"text":note.text,"pending_until_set_saved":note.pending})).collect::<Vec<_>>(),
+        "bridge_calls":run.requests.iter().map(|request| json!({"name":request.name,"arguments":request.args,"result":request.result})).collect::<Vec<_>>()
+    }));
+    passed
+}
