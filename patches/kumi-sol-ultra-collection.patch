+    #[test]
+    fn public_response_rejects_private_reasoning_and_invalid_calls() {
+        let empty = vec![];
+        for response in [
+            json!({"call_id":"c1","content":"done","tool_calls":[],"reasoning":"private"}),
+            json!({"call_id":"wrong","content":"done","tool_calls":[]}),
+            json!({"call_id":"c1","tool_calls":[{"id":"t1","name":"invented","arguments":{}}]}),
+            json!({"call_id":"c1","tool_calls":[{"id":"t1","name":"invented","arguments":"{}"}]}),
+            json!({"call_id":"c1","tool_calls":[]}),
+        ] {
+            assert!(response_parts(stringify(&response).as_bytes(), "c1", &empty).is_err(), "{response}");
+        }
+        assert!(response_parts(br#"{"call_id":"c1","content":"Confirmed.","tool_calls":[]}"#, "c1", &empty).is_ok());
+    }
