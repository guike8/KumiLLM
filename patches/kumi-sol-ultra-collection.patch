+pub(super) async fn collect(directory: &Path, catalog: &Rc<ListToolsResult>, watched: &Rc<Watched>) -> Result<i32, RuntimeError> {
+    let selection = PilotSelection::parse(
+        std::env::var("KUMI_SOL_START").ok().as_deref(),
+        std::env::var("KUMI_SOL_LIMIT").ok().as_deref(),
+        std::env::var("KUMI_SOL_SERIES").ok().as_deref(),
+    )?;
+    let queue = std::env::var_os("KUMI_SOL_QUEUE_DIR")
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+        .ok_or_else(|| RuntimeError::plain("KUMI_SOL_QUEUE_DIR is required."))?;
+    std::fs::create_dir(directory).map_err(failure)?;
+    let raw = directory.join("raw");
+    std::fs::create_dir(&raw).map_err(failure)?;
+    std::fs::create_dir_all(&queue).map_err(failure)?;
+    for name in ["requests", "responses"] {
+        let path = queue.join(name);
+        if path.symlink_metadata().is_ok_and(|metadata| !metadata.file_type().is_dir()) {
+            return Err(RuntimeError::plain("Queue surfaces must be directories, never symlinks."));
+        }
+        std::fs::create_dir_all(&path).map_err(failure)?;
+        if std::fs::read_dir(&path).map_err(failure)?.next().is_some() {
+            return Err(RuntimeError::plain("Sol collection requires an empty request and response queue."));
+        }
+    }
+    let limit = selection.count;
+    let total_calls = Rc::new(Cell::new(0));
+    let mut passed = 0;
+    for (offset, kind) in (selection.start..selection.start + limit).enumerate() {
+        let goal = Goal::new(kind, &selection.series);
+        ACTIVE.with(|stored| *stored.borrow_mut() = Some(goal.clone()));
+        VERIFICATION.with(|stored| *stored.borrow_mut() = Value::Null);
+        let model = Counted::new(binding(&queue, &goal.episode_id, total_calls.clone()));
+        let case = naming("sol novel pilot", prompts, verify);
+        let outcome = match run_case(&model, &case, catalog, watched).await {
+            Ok(outcome) => outcome,
+            Err(error) => Outcome {
+                name: case.name,
+                calls: model.counting.calls.get(),
+                error: Some(safe_error(Some(&error), &[])),
+                ..Default::default()
+            },
+        };
+        passed += usize::from(outcome.passed);
+        let verification = VERIFICATION.with(|stored| stored.borrow().clone());
+        let verification = if verification.is_null() {
+            json!({"passed":false,"checks":{"session_completed_and_verified":false},
+                "before":BEFORE.with(|stored| stored.borrow().clone()),"after":LATEST.with(|stored| stored.borrow().clone()),
+                "verifier":"independent_synthetic_ableton_state_and_actual_readback","real_live_verified":false,"audio_quality_verified":false,"error":outcome.error,
+                "bridge_calls":BRIDGE_CALLS.with(|stored| stored.borrow().clone())})
+        } else {
+            verification
+        };
+        let record = json!({"format_version":1,"episode_id":goal.episode_id,"project_id":goal.project_id,
+            "project_family_id":goal.project_family_id,"split":goal.split,"scope":"executed_synthetic_kumi",
+            "teacher":"gpt-6.1-sol-ultra","teacher_model":MODEL,"teacher_model_requested":MODEL,"teacher_reasoning_effort":EFFORT,
+            "teacher_transport":TRANSPORT,"teacher_provenance":"Codex subagent file queue, not a direct API sampling run",
+            "source_revision":"2ff07a5be515e0a267ea86f7c3d56fa579b607ea","goals":goal,
+            "verification":verification,"outcome":outcome,"calls":model.counting.capture.borrow().clone(),
+            "benchmark_cases_used":false,"execution_host":std::env::var("KUMI_SOL_EXECUTION_HOST").ok(),"created_at_ms":now_ms()});
+        write_private(&raw.join(format!("{}.json", goal.episode_id)), &record).map_err(failure)?;
+        append_result(
+            &directory.join("progress.jsonl"),
+            &json!({"episode_id":goal.episode_id,"split":goal.split,"predicate_passed":outcome.passed,"error":outcome.error,"completed":offset+1}),
+        )?;
+        println!("sol_collected {}/{} {} predicate={}", offset + 1, limit, goal.episode_id, outcome.passed);
+    }
+    ACTIVE.with(|stored| *stored.borrow_mut() = None);
+    let manifest = json!({"format_version":1,"completed_episodes":limit,"predicate_passed_episodes":passed,
+        "start_index":selection.start,"series":selection.series,
+        "status":"raw_collection_complete_pending_strict_admission","scope":"executed_synthetic_kumi",
+        "teacher":"gpt-6.1-sol-ultra","teacher_model":MODEL,"teacher_model_requested":MODEL,"teacher_reasoning_effort":EFFORT,"teacher_transport":TRANSPORT,
+        "teacher_provenance":"Codex subagent file queue, not a direct API sampling run","teacher_calls":total_calls.get(),
+        "max_teacher_calls":MAX_CALLS,"response_timeout_ms":300_000,"turn_limit_ms":600_000,
+        "real_live_verified":false,"audio_quality_verified":false,"benchmark_cases_used":false,
+        "split_rule":"Four new task families are train-only pilot material; keep existing benchmark and held-out families untouched.",
+        "limitations":["Synthetic Ableton state and genuine Kumi tool execution; no real DAW or audio verification.","Four novel pilot episodes do not establish model competitiveness.","Teacher output is supplied by a Codex Sol Ultra subagent, not a direct provider API."]});
+    atomic_request(&directory.join("collection.json"), &manifest).map_err(failure)?;
+    Ok(if passed == limit { 0 } else { 1 })
+}
