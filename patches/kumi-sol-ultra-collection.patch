+            );
+            checks.insert(
+                "fresh_name_and_tempo_readback".into(),
+                json!(
+                    has_row(run, "track", "5:track:2", "name", &json!(goal.names[2]))
+                        && fresh_rows(run, "set").iter().any(|row| row["tempo"].as_f64() == Some(137.5))
+                ),
