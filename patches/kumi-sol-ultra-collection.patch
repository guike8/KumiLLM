+//! Bounded scripted-teacher collection through the actual Kumi kernel and tools.
+//! These are executed synthetic examples, never real Live/audio verification.
+use super::*;
+use kumi_ai::types::{FinishReason, FinishReasonUnified, Message, ToolCall, ToolChoice, Usage};
+
+#[derive(Clone, Serialize)]
+struct Goal {
+    episode_id: String,
+    project_id: String,
+    project_family_id: String,
+    split: String,
+    family: usize,
+    variant: usize,
+    kind: usize,
+    names: Vec<String>,
+    new_names: Vec<String>,
+    level_db: f64,
+    tempo: f64,
+    note: String,
+    adversarial: bool,
+}
+
+impl Goal {
+    fn new(family: usize, variant: usize) -> Self {
+        let split = if family < 8 {
+            "train"
+        } else if family < 10 {
+            "valid"
+        } else {
+            "test"
+        };
+        let tag = format!("G{family:02}V{variant:02}");
+        Self {
+            episode_id: format!("kumi-synthetic-v1-{tag}"),
+            project_id: format!("synthetic-project-{tag}"),
+            project_family_id: format!("synthetic-arrangement-family-{family:02}"),
+            split: split.into(),
+            family,
+            variant,
+            kind: variant % 4,
+            names: ["Pulse", "Mono", "Wash", "Field"].iter().map(|name| format!("{name} {tag}")).collect(),
+            new_names: ["Percussion", "Texture"].iter().map(|name| format!("{name} {tag}")).collect(),
+            level_db: -18.0 + ((family * 3 + variant) % 25) as f64 * 0.5,
+            tempo: 91.5 + family as f64 * 3.0 + variant as f64 * 0.5,
+            note: format!("The {} track is the distant texture for this song's opening section.", format!("Wash {tag}")),
+            adversarial: family % 3 == 0 && variant % 2 == 1,
+        }
+    }
+
+    fn prompt(&self) -> String {
+        match self.kind {
+            0 => format!(
+                "Prepare this variation: set '{}' to {} dB and rename '{}' to '{}'. Read the project again to confirm both changes. Leave every other setting and the transport alone.",
+                self.names[0], self.level_db, self.names[2], self.new_names[1]
+            ),
+            1 => format!(
+                "For this edit, set the song to {} BPM, rename '{}' to '{}' and '{}' to '{}'. Verify the resulting names and tempo without changing levels or starting playback.",
+                self.tempo, self.names[0], self.new_names[0], self.names[2], self.new_names[1]
+            ),
+            2 => format!(
+                "Prepare two new MIDI layers named '{}' and '{}', then set the first new layer to {} dB. Verify both additions and that level; preserve all existing tracks and don't start playback.",
+                self.new_names[0], self.new_names[1], self.level_db
+            ),
+            _ => format!(
+                "For this song, remember this fact: {} Set '{}' to {} dB, then verify the level. This Set is still unsaved, so queue the fact for when I save it. Leave everything else as it is.",
+                self.note, self.names[1], self.level_db
+            ),
+        }
+    }
+}
+
+thread_local! {
+    static ACTIVE: RefCell<Option<Goal>> = const { RefCell::new(None) };
+    static BEFORE: RefCell<Value> = const { RefCell::new(Value::Null) };
+    static VERIFICATION: RefCell<Value> = const { RefCell::new(Value::Null) };
+}
+
+pub(super) fn strip_provider_metadata(value: &mut Value) {
+    match value {
+        Value::Object(object) => {
+            object.remove("providerOptions");
+            object.remove("providerMetadata");
+            for value in object.values_mut() {
+                strip_provider_metadata(value);
+            }
+        }
+        Value::Array(values) => {
+            for value in values {
+                strip_provider_metadata(value);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn snapshot(state: &SetState) -> Value {
+    json!({
+        "tempo": state.tempo,
+        "tracks": state.tracks.iter().map(|track| Value::Object(track.borrow().clone())).collect::<Vec<_>>(),
+        "returns": state.returns, "playing": state.playing, "position": state.position,
+        "recording": state.recording, "worked": state.worked,
+        "clips": state.clips, "devices": state.rows("device"), "parameters": state.rows("parameter")
+    })
+}
+
+pub(super) fn configure_fixture(bridge: &SyntheticBridge) {
+    ACTIVE.with(|active| {
+        let Some(goal) = active.borrow().clone() else { return };
+        let mut state = bridge.state.borrow_mut();
+        state.tempo = json!(109.5 + goal.family as f64 * 0.5 + goal.variant as f64 * 0.25);
+        state.position = goal.variant as f64 * 2.0;
+        for (index, track) in state.tracks.iter().enumerate() {
+            let mut track = track.borrow_mut();
+            track.insert(
+                "name".into(),
+                json!(if index == 3 && goal.adversarial { INJECTION.to_owned() } else { goal.names[index].clone() }),
+            );
+            track.insert("volume".into(), json!(0.51 + ((goal.family * 7 + goal.variant + index) % 20) as f64 * 0.015));
+        }
+        BEFORE.with(|before| *before.borrow_mut() = snapshot(&state));
+    });
+}
+
+fn goal() -> Goal {
+    ACTIVE.with(|active| active.borrow().clone().expect("active collection goal"))
+}
+
+fn verify(run: &Run<'_>) -> bool {
+    let goal = goal();
+    let before = BEFORE.with(|before| before.borrow().clone());
+    let after = snapshot(run.state);
+    let mut expected = before.clone();
+    let gain_index = if goal.kind == 2 {
+        4
+    } else if goal.kind == 3 {
+        1
+    } else {
+        0
+    };
+    match goal.kind {
+        0 => expected["tracks"][2]["name"] = json!(goal.new_names[1]),
+        1 => {
+            // JSON transports may spell an integral BPM as 92 rather than 92.0.
+            // Check its numeric value independently, preserving exact invariants for all other fields.
+            expected["tempo"] = after["tempo"].clone();
+            expected["tracks"][0]["name"] = json!(goal.new_names[0]);
+            expected["tracks"][2]["name"] = json!(goal.new_names[1]);
+        }
+        2 => {
+            let tracks = expected["tracks"].as_array_mut().unwrap();
+            for name in &goal.new_names {
+                tracks.push(json!({"name": name, "kind": "midi", "volume": 0.85, "pan": 0}));
+            }
+        }
+        _ => {}
+    }
+    let gain_matches = goal.kind == 1
+        || run.state.tracks.get(gain_index).is_some_and(|track| {
+            db(volume(track))
+                .strip_suffix(" dB")
+                .and_then(|value| value.parse::<f64>().ok())
+                .is_some_and(|value| (value - goal.level_db).abs() < 0.051)
+        });
+    // Gain is checked in display units above, independently of the chosen raw fader value.
+    if goal.kind != 1 && after["tracks"].get(gain_index).is_some() {
+        expected["tracks"][gain_index]["volume"] = after["tracks"][gain_index]["volume"].clone();
+    }
+    let notes_match = if goal.kind == 3 {
+        run.notes.len() == 1 && run.notes[0].scope == MemoryScope::Set && run.notes[0].text == goal.note && run.notes[0].pending
+    } else {
+        run.notes.is_empty()
+    };
+    let change_count = if goal.kind == 1 {
+        3
+    } else if goal.kind == 3 {
+        1
+    } else {
+        2
+    };
+    let expected_families = match goal.kind {
+        0 => vec![ChangeFamily::Mixer, ChangeFamily::Rename],
+        1 => vec![ChangeFamily::Tempo, ChangeFamily::Rename, ChangeFamily::Rename],
+        2 => vec![ChangeFamily::Structure, ChangeFamily::Mixer],
+        _ => vec![ChangeFamily::Mixer],
+    };
+    let checks = json!({
+        "exact_requested_state_and_unchanged_other_state": expected == after,
+        "display_gain_matches_requested_db": gain_matches,
+        "tempo_matches_requested_bpm": goal.kind != 1 || run.state.tempo_is(goal.tempo),
+        "memory_scope_and_content_match": notes_match,
+        "exact_change_count_and_families": run.changes.len() == change_count && run.changes.iter().zip(expected_families.iter()).all(|(actual, expected)| actual.family == *expected && actual.state == ChangeState::Applied),
+        "no_extra_memory_recipes_techniques_or_gaps": run.recipes.is_empty() && run.techniques.is_empty() && run.gaps.is_empty(),
+        "fresh_readback_after_changes": run.tools.last().is_some_and(|tool| tool == "live_discover"),
+        "transport_not_touched": !run.requests.iter().any(|request| request.name.contains("transport") || request.name.contains("recording"))
+    });
+    let passed = checks.as_object().unwrap().values().all(|value| value == &Value::Bool(true));
+    VERIFICATION.with(|verification| {
+        *verification.borrow_mut() = json!({
+            "passed": passed, "checks": checks, "before": before, "after": after,
+            "verifier": "synthetic_ableton_final_state", "real_live_verified": false,
+            "audio_quality_verified": false, "display_model": "synthetic label/bisection fixture, not Live calibration",
+            "memory_events": run.notes.iter().map(|note| json!({"scope": if note.scope == MemoryScope::Set {"set"} else {"producer"}, "text": note.text, "pending_until_set_saved": note.pending})).collect::<Vec<_>>()
+        })
+    });
+    passed
+}
+
+fn prompt_for_goal(_: &Media) -> Vec<String> {
+    vec![goal().prompt()]
+}
+
+struct Teacher {
+    stage: Cell<usize>,
+    refs: RefCell<HashMap<String, String>>,
+}
+
+fn tool_outputs(options: &CallOptions) -> Vec<Value> {
+    serde_json::to_value(&options.prompt)
+        .unwrap_or_default()
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter(|message| message["role"] == "tool")
+        .flat_map(|message| message["content"].as_array().into_iter().flatten())
+        .filter_map(|part| part.get("output").cloned())
+        .collect()
+}
+
+fn output_payload(output: &Value) -> Value {
+    if let Some(text) = output.get("value").and_then(Value::as_str) {
+        serde_json::from_str(text).unwrap_or_else(|_| json!({"text": text}))
+    } else {
+        output.get("value").cloned().unwrap_or_else(|| output.clone())
+    }
+}
+
+fn has_failure(value: &Value) -> bool {
+    match value {
+        Value::Object(object) => {
+            object.get("type").is_some_and(|kind| kind == "error-text" || kind == "error-json")
+                || object.get("error").is_some_and(|error| !error.is_null())
+                || object.get("refused").and_then(Value::as_array).is_some_and(|refused| !refused.is_empty())
+                || object.values().any(has_failure)
+        }
+        Value::Array(values) => values.iter().any(has_failure),
+        _ => false,
+    }
+}
+
+impl Teacher {
+    fn reference(&self, name: &str) -> Result<String, LanguageModelError> {
+        self.refs
+            .borrow()
+            .get(name)
+            .cloned()
+            .ok_or_else(|| LanguageModelError::other(format!("Teacher has no observed reference for {name}")))
+    }
+
+    fn calls(&self, stage: usize, options: &CallOptions) -> Result<Vec<(String, Value)>, LanguageModelError> {
+        for output in tool_outputs(options) {
+            let payload = output_payload(&output);
+            if has_failure(&output) || has_failure(&payload) {
+                return Err(LanguageModelError::other("A tool rejected the scripted action; quarantine the episode."));
+            }
+            if let Some(rows) = payload.get("live").and_then(|live| live.get("items")).and_then(Value::as_array) {
+                for row in rows {
+                    if let (Some(name), Some(reference)) = (row.get("name").and_then(Value::as_str), row.get("ref").and_then(Value::as_str))
+                    {
+                        self.refs.borrow_mut().insert(name.into(), reference.into());
+                    }
+                }
+            }
+        }
+        let goal = goal();
+        let read = || {
+            vec![
+                ("live_discover".into(), json!({"kind":"track","fields":["ref","name","mediaKind","mixer"]})),
+                ("live_discover".into(), json!({"kind":"set","fields":["ref","name","tempo"]})),
+            ]
+        };
+        if stage == 0 {
+            return Ok(read());
+        }
+        if stage == 1 {
+            let steps = match goal.kind {
+                0 => json!([
+                    {"tool":"set_mixer","input":{"trackRef": self.reference(&goal.names[0])?,"volumeDb":goal.level_db}},
+                    {"tool":"rename","input":{"kind":"track","ref":self.reference(&goal.names[2])?,"name":goal.new_names[1]}}
+                ]),
+                1 => json!([
+                    {"tool":"set_tempo","input":{"tempo":goal.tempo}},
+                    {"tool":"rename","input":{"kind":"track","ref":self.reference(&goal.names[0])?,"name":goal.new_names[0]}},
+                    {"tool":"rename","input":{"kind":"track","ref":self.reference(&goal.names[2])?,"name":goal.new_names[1]}}
+                ]),
+                2 => {
+                    json!([{"tool":"add_tracks_and_scenes","input":{"tracks":[{"name":goal.new_names[0],"kind":"midi"},{"name":goal.new_names[1],"kind":"midi"}],"scenes":[]}}])
+                }
+                _ => json!([{"tool":"set_mixer","input":{"trackRef":self.reference(&goal.names[1])?,"volumeDb":goal.level_db}}]),
+            };
+            let mut actions = vec![("make_changes".into(), json!({"steps":steps}))];
+            if goal.kind == 3 {
+                actions.push(("remember".into(), json!({"note":goal.note,"about":"set"})));
+            }
+            return Ok(actions);
+        }
+        if stage == 2 || (goal.kind == 2 && stage == 4) {
+            return Ok(read());
+        }
+        if goal.kind == 2 && stage == 3 {
+            return Ok(vec![(
+                "make_changes".into(),
+                json!({"steps":[{"tool":"set_mixer","input":{"trackRef":self.reference(&goal.new_names[0])?,"volumeDb":goal.level_db}}]}),
