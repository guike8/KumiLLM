+struct QueueTeacher {
+    queue: PathBuf,
+    episode_id: String,
+    episode_calls: Cell<usize>,
+    total_calls: Rc<Cell<usize>>,
+}
+
+fn atomic_request(path: &Path, value: &Value) -> std::io::Result<()> {
+    if path.symlink_metadata().is_ok() {
+        return Err(std::io::Error::new(std::io::ErrorKind::AlreadyExists, "Refusing an existing teacher request."));
+    }
+    let temporary = path.with_extension("json.tmp");
+    let mut options = std::fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+    let mut file = options.open(&temporary)?;
+    file.write_all(stringify(value).as_bytes())?;
+    file.sync_all()?;
+    std::fs::rename(temporary, path)
+}
+
+fn regular_response(path: &Path) -> std::io::Result<Option<Vec<u8>>> {
+    let metadata = match path.symlink_metadata() {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error),
+    };
+    if !metadata.file_type().is_file() || metadata.len() > 2_000_000 {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "Teacher response must be a regular file of at most 2 MB."));
+    }
+    std::fs::read(path).map(Some)
+}
+
+#[async_trait(?Send)]
+impl LanguageModel for QueueTeacher {
+    async fn do_stream(&self, options: CallOptions) -> Result<StreamParts, LanguageModelError> {
+        if self.total_calls.get() >= MAX_CALLS {
+            return Err(LanguageModelError::other("Sol pilot reached its 30-call limit."));
+        }
+        self.total_calls.set(self.total_calls.get() + 1);
+        self.episode_calls.set(self.episode_calls.get() + 1);
+        let call_id = format!("{}-c{:03}", self.episode_id, self.episode_calls.get());
+        let mut request = json!({"episode_id":self.episode_id,"call_id":call_id,
+            "request":{"prompt":options.prompt,"tools":options.tools,"toolChoice":options.tool_choice},
+            "model_requested":MODEL,"reasoning_effort":EFFORT,"teacher_transport":TRANSPORT});
+        collection::strip_provider_metadata(&mut request);
+        let request_path = self.queue.join("requests").join(format!("{call_id}.json"));
+        let response_path = self.queue.join("responses").join(format!("{call_id}.json"));
+        if response_path.symlink_metadata().is_ok() {
+            return Err(LanguageModelError::other("Refusing a response that predates its teacher request."));
+        }
+        atomic_request(&request_path, &request).map_err(|error| LanguageModelError::other(error.to_string()))?;
+        println!("sol_teacher_request {call_id}");
+        let deadline = tokio::time::Instant::now() + Duration::from_secs(300);
+        loop {
+            if options.abort_signal.as_ref().is_some_and(Signal::is_cancelled) {
+                return Err(LanguageModelError::other("Sol teacher request was cancelled."));
+            }
+            if let Some(bytes) = regular_response(&response_path).map_err(|error| LanguageModelError::other(error.to_string()))? {
+                return response_parts(&bytes, &call_id, options.tools.as_deref().unwrap_or(&[]))
+                    .map(|parts| Box::pin(futures::stream::iter(parts)) as StreamParts);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(LanguageModelError::other(format!("Sol teacher response timed out after 300 seconds: {call_id}")));
+            }
+            tokio::time::sleep(Duration::from_millis(200)).await;
+        }
+    }
+}
+
+fn binding(queue: &Path, episode_id: &str, total_calls: Rc<Cell<usize>>) -> ModelBinding {
+    ModelBinding {
+        id: format!("{MODEL}/{EFFORT}/{TRANSPORT}"),
+        model: Rc::new(QueueTeacher { queue: queue.into(), episode_id: episode_id.into(), episode_calls: Cell::new(0), total_calls }),
+        prepare: Box::new(|request| {
+            let mut prompt = vec![Message::System { content: request.instructions, provider_options: None }];
+            prompt.extend(kumi_ai::providers::words_only(request.messages));
+            CallOptions { prompt, tools: Some(request.tools), tool_choice: Some(ToolChoice::Auto), ..Default::default() }
+        }),
+        budget: None,
+    }
+}
