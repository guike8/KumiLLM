+impl Goal {
+    fn new(kind: usize, series: &str) -> Self {
+        let tag = format!("{series}E{:02}", kind + 1);
+        Self {
+            episode_id: format!("kumi-sol-v2-{tag}"),
+            project_id: format!("sol-project-{tag}"),
+            project_family_id: format!("sol-novel-family-{:02}", kind + 1),
+            split: "train",
+            kind,
+            names: ["Pulse", "Sub", "Reed", "Field"].iter().map(|name| format!("{name} {tag}")).collect(),
+        }
+    }
