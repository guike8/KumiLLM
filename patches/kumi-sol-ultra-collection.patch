+    fn prompts(&self) -> Vec<String> {
+        match self.kind {
+            0 => vec![format!(
+                "Create a new two-bar (8 beat) MIDI clip named 'Lilt' in the empty second Session scene on '{}'. Write exactly these notes, using beats from the clip start: MIDI pitch 60 at 0, 64 at 1, 67 at 2, and 71 at 3. Each lasts 0.5 beat, velocity 90, unmuted. Leave the rest of the clip empty. Read its notes back to verify them. Preserve all existing clips, tracks and settings; do not play.", self.names[2]
+            )],
+            1 => vec![
+                format!("Make two separate edits, in this order: set the tempo to 137.5 BPM, then rename '{}' to 'Halo'. Verify both edits. Leave everything else alone and do not play.", self.names[2]),
+                "Undo only your latest edit, leaving the earlier tempo change in place. Read the project again to verify the resulting name and tempo. Make no other changes.".into(),
+            ],
+            2 => vec!["Move the arrangement playhead to the start of bar 9 in this 4/4 song without starting playback. Find the appropriate transport tool, use it, then read the transport again to confirm the position and stopped state. Preserve everything else.".into()],
+            _ => vec![
+                "Across projects, my preference is that new track names are UPPERCASE. Remember this producer preference for future work.".into(),
+                "Add one new MIDI track named marimba, following my track-naming preference. Read back its name. Preserve all existing tracks and other settings and do not play.".into(),
+            ],
+        }
