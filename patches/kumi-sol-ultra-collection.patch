+struct PilotSelection {
+    start: usize,
+    count: usize,
+    series: String,
+}
+
+impl PilotSelection {
+    fn parse(start: Option<&str>, limit: Option<&str>, series: Option<&str>) -> Result<Self, RuntimeError> {
+        let start = start
+            .unwrap_or("0")
+            .parse::<usize>()
+            .map_err(|_| RuntimeError::plain("KUMI_SOL_START must be an integer from 0 through 3."))?;
+        if start > 3 {
+            return Err(RuntimeError::plain("KUMI_SOL_START must be an integer from 0 through 3."));
+        }
+        let count = limit.unwrap_or("4").parse::<usize>().map_err(|_| RuntimeError::plain("KUMI_SOL_LIMIT must be a positive integer."))?;
+        if count == 0 {
+            return Err(RuntimeError::plain("KUMI_SOL_LIMIT must be a positive integer."));
+        }
+        let series = series.unwrap_or("S02");
+        if series.is_empty() || series.len() > 32 || !series.bytes().all(|byte| byte.is_ascii_alphanumeric()) {
+            return Err(RuntimeError::plain("KUMI_SOL_SERIES must contain 1 to 32 ASCII letters or digits."));
+        }
+        Ok(Self { start, count: count.min(4 - start), series: series.into() })
+    }
+}
