+fn actual_deferred_transport_calls(conversation: &str) -> bool {
+    let messages = serde_json::from_str::<Vec<Value>>(conversation).unwrap_or_default();
+    let calls = messages
+        .iter()
+        .filter(|message| message["role"] == "assistant")
+        .filter_map(|message| message["content"].as_array())
+        .flatten()
+        .filter(|part| part["type"] == "tool-call")
+        .collect::<Vec<_>>();
+    let find = calls.iter().position(|part| part["toolName"] == "find_tools");
+    let Some(find) = find else { return false };
+    calls[find + 1..].iter().any(|part| {
+        let Some(input) = part.get("input").filter(|input| !input.is_null()).or_else(|| part.get("args")) else { return false };
+        (part["toolName"] == "call_tool" && input["name"] == "set_transport")
+            || (part["toolName"] == "make_changes"
+                && input["steps"]
+                    .as_array()
+                    .is_some_and(|steps| steps.iter().any(|step| step["tool"] == "set_transport" && step["input"].is_object())))
+    })
+}
