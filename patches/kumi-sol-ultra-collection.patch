+pub(super) fn configure_fixture(bridge: &SyntheticBridge) {
+    if !active() {
+        return;
+    }
+    let goal = goal();
+    let state = bridge.state.borrow_mut();
+    for (index, track) in state.tracks.iter().enumerate() {
+        track.borrow_mut().insert("name".into(), json!(goal.names[index]));
+    }
+    let before = snapshot(&state);
+    BEFORE.with(|stored| *stored.borrow_mut() = before.clone());
+    LATEST.with(|stored| *stored.borrow_mut() = before);
+    BRIDGE_CALLS.with(|stored| stored.borrow_mut().clear());
+    TURN_CHECKPOINTS.with(|stored| stored.borrow_mut().clear());
+    EVER_PLAYING_OR_RECORDING.with(|stored| stored.set(false));
+}
+
+pub(super) fn capture_bridge(bridge: &SyntheticBridge) {
+    if active() {
+        let state = bridge.state.borrow();
+        if state.playing || state.recording.values().any(|recording| *recording) {
+            EVER_PLAYING_OR_RECORDING.with(|stored| stored.set(true));
+        }
+        drop(state);
+        LATEST.with(|stored| *stored.borrow_mut() = snapshot(&bridge.state.borrow()));
+        BRIDGE_CALLS.with(|stored| {
+            *stored.borrow_mut() = bridge
+                .requests
+                .borrow()
+                .iter()
+                .map(|request| json!({"name":request.name,"arguments":request.args,"result":request.result}))
+                .collect()
+        });
+    }
+}
