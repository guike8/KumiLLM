+    #[test]
+    fn targeted_selection_uses_new_ids_and_preserves_family_grouping() {
+        let original = PilotSelection::parse(None, None, None).unwrap();
+        assert_eq!((original.start, original.count, original.series.as_str()), (0, 4, "S02"));
+        let targeted = PilotSelection::parse(Some("2"), Some("1"), Some("S03")).unwrap();
+        assert_eq!((targeted.start, targeted.count), (2, 1));
+        let old_goal = Goal::new(2, &original.series);
+        let new_goal = Goal::new(targeted.start, &targeted.series);
+        assert_eq!(new_goal.episode_id, "kumi-sol-v2-S03E03");
+        assert_ne!(old_goal.project_id, new_goal.project_id);
+        assert_eq!(old_goal.project_family_id, new_goal.project_family_id);
+        assert_eq!(PilotSelection::parse(Some("3"), Some("4"), None).unwrap().count, 1);
+        for (start, count, series) in [
+            (Some("4"), None, None),
+            (Some("-1"), None, None),
+            (None, Some("0"), None),
+            (None, None, Some("../S03")),
+            (None, None, Some("S_03")),
+            (None, None, Some("")),
+        ] {
+            assert!(PilotSelection::parse(start, count, series).is_err());
+        }
+    }
