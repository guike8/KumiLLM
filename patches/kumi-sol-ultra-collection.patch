+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PublicResponse {
+    call_id: String,
+    #[serde(default)]
+    content: Option<String>,
+    tool_calls: Vec<PublicToolCall>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PublicToolCall {
+    id: String,
+    name: String,
+    arguments: JsonObject,
+}
+
+fn response_parts(bytes: &[u8], call_id: &str, tools: &[FunctionTool]) -> Result<Vec<StreamPart>, LanguageModelError> {
+    let response: PublicResponse =
+        serde_json::from_slice(bytes).map_err(|error| LanguageModelError::other(format!("Invalid public teacher response: {error}")))?;
+    if response.call_id != call_id {
+        return Err(LanguageModelError::other("Teacher response call_id does not match the request."));
+    }
+    if response.tool_calls.is_empty() && response.content.as_ref().is_none_or(|content| content.trim().is_empty()) {
+        return Err(LanguageModelError::other("Teacher returned neither public content nor tool calls."));
+    }
+    let mut ids = HashSet::new();
+    let mut parts = vec![];
+    if let Some(content) = response.content.filter(|content| !content.is_empty()) {
+        parts.push(StreamPart::TextDelta { id: format!("{call_id}-text"), delta: content, provider_metadata: None });
+    }
+    let reason = if response.tool_calls.is_empty() { FinishReasonUnified::Stop } else { FinishReasonUnified::ToolCalls };
+    for tool in response.tool_calls {
+        if tool.id.trim().is_empty() || tool.id.len() > 256 || !ids.insert(tool.id.clone()) {
+            return Err(LanguageModelError::other("Teacher tool call IDs must be nonempty, bounded and unique."));
+        }
+        if !tools.iter().any(|offered| offered.name == tool.name) {
+            return Err(LanguageModelError::other(format!("Teacher tool {} was not offered by Kumi.", tool.name)));
+        }
+        parts.push(StreamPart::ToolCall(ToolCall {
+            tool_call_id: tool.id,
+            tool_name: tool.name,
+            input: stringify(&Value::Object(tool.arguments)),
+            provider_executed: None,
+            dynamic: None,
+            provider_metadata: None,
+        }));
+    }
+    parts.push(StreamPart::Finish {
+        usage: Usage::default(),
+        finish_reason: FinishReason { unified: reason, raw: None },
+        provider_metadata: None,
+    });
+    Ok(parts)
+}
