+/// The same strict label ordering as mixer-display.py: no number guessing or expression evaluation.
+fn mixer_label_order(label: &str) -> Option<f64> {
+    static LEVEL: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^(-?[0-9]+(?:\.[0-9]+)?|-inf) ?dB$").unwrap());
+    static PAN: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^([1-9][0-9]?)([LR])$").unwrap());
+    let label = label.replace('\u{a0}', " ");
+    let label = label.trim();
+    if let Some(level) = LEVEL.captures(label) {
+        return if &level[1] == "-inf" { Some(f64::NEG_INFINITY) } else { level[1].parse().ok() };
+    }
+    if label == "C" {
+        return Some(0.0);
     }
+    let pan = PAN.captures(label)?;
+    let amount: f64 = pan[1].parse().ok()?;
+    Some(if &pan[2] == "L" { -amount } else { amount })
+}
