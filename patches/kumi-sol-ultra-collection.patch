+    fn queue_request_is_atomic_and_refuses_overwrite() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("c1.json");
+        atomic_request(&path, &json!({"call_id":"c1"})).unwrap();
+        assert_eq!(
+            regular_response(&path).unwrap().map(|bytes| serde_json::from_slice::<Value>(&bytes).unwrap()),
+            Some(json!({"call_id":"c1"}))
+        );
+        assert!(atomic_request(&path, &json!({"call_id":"replacement"})).is_err());
+        assert!(!path.with_extension("json.tmp").exists());
+    }
