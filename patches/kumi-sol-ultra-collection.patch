+fn verify(run: &Run<'_>) -> bool {
+    let goal = goal();
+    let before = BEFORE.with(|value| value.borrow().clone());
+    let after = snapshot(run.state);
+    let mut expected = before.clone();
+    let mut checks = serde_json::Map::new();
+    match goal.kind {
+        0 => {
+            let clip = run.state.clips.get("5:clip:2:1");
+            let exact = clip.is_some_and(|(name, length, notes)| name == "Lilt" && *length == 8.0 && notes_match(notes));
+            if let Some(clip) = clip {
+                expected["clips"]["5:clip:2:1"] = json!(clip);
+            }
+            checks.insert("exact_requested_notes".into(), json!(exact));
+            checks.insert(
+                "one_clip_change".into(),
+                json!(
+                    run.changes.len() == 1 && run.changes[0].family == ChangeFamily::Clip && run.changes[0].state == ChangeState::Applied
+                ),
+            );
+            let notes_read = mutation_index(run)
+                .map(|index| {
+                    run.requests[index + 1..]
+                        .iter()
+                        .filter(|request| {
+                            request.name == "live_discover"
+                                && request.text("kind") == Some("note")
+                                && request.text("parent") == Some("5:clip:2:1")
+                        })
+                        .flat_map(|request| request.result["structuredContent"]["items"].as_array().cloned().unwrap_or_default())
+                        .collect::<Vec<_>>()
+                })
+                .unwrap_or_default()
+                .into_iter()
+                .map(|mut row| {
+                    if let Some(row) = row.as_object_mut() {
+                        row.remove("ref");
+                        row.remove("parentRef");
+                        row.remove("id");
+                    }
+                    row
+                })
+                .collect::<Vec<_>>();
+            checks.insert(
+                "actual_fresh_note_readback".into(),
+                json!(run.tools.iter().any(|name| name == "read_notes") && notes_match(&notes_read)),
+            );
+            checks.insert(
+                "actual_clip_write".into(),
+                json!(
+                    run.requests.iter().any(|request| request.name == "live_midi_clip_preview")
+                        && run.requests.iter().any(|request| request.name == "live_midi_clip_apply")
+                ),
