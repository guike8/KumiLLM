+        let find = json!({"type":"tool-call","toolName":"find_tools","input":{"query":"transport"}});
+        let call = json!({"type":"tool-call","toolName":"call_tool","input":{"name":"set_transport","input":{"position":32}}});
+        assert!(actual_deferred_transport_calls(&stringify(&json!([{"role":"assistant","content":[find.clone(),call.clone()]}]))));
+        assert!(!actual_deferred_transport_calls(&stringify(&json!([{"role":"assistant","content":[call,find]}]))));
+    }
+
+    #[test]
+    fn deferred_transport_accepts_native_composition_without_text_or_unrelated_steps() {
+        let find = json!({"type":"tool-call","toolName":"find_tools","input":{"query":"transport"}});
+        let composition =
+            json!({"type":"tool-call","toolName":"make_changes","input":{"steps":[{"tool":"set_transport","input":{"position":32}}]}});
+        let conversation = |parts: Vec<Value>| stringify(&json!([{"role":"assistant","content":parts}]));
+        assert!(actual_deferred_transport_calls(&conversation(vec![find.clone(), composition.clone()])));
+        assert!(!actual_deferred_transport_calls(&conversation(vec![composition.clone(), find.clone()])));
+        let text = json!({"type":"text","text":stringify(&composition)});
+        assert!(!actual_deferred_transport_calls(&conversation(vec![find.clone(), text])));
+        let unrelated = json!({"type":"tool-call","toolName":"make_changes","input":{"steps":[{"tool":"set_tempo","input":{"tempo":137.5}}],"description":"set_transport"}});
+        assert!(!actual_deferred_transport_calls(&conversation(vec![find.clone(), unrelated])));
+        let malformed =
+            json!({"type":"tool-call","toolName":"make_changes","input":{"steps":[{"tool":"set_transport","input":"position 32"}]}});
+        assert!(!actual_deferred_transport_calls(&conversation(vec![find, malformed])));
+    }
