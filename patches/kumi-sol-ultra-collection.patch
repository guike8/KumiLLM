+/// Optional Live note defaults are accepted only at their normal values; no extra musical data is ignored.
+fn notes_match(notes: &[Value]) -> bool {
+    if notes.len() != 4 {
+        return false;
+    }
+    notes.iter().zip(expected_notes()).all(|(actual, expected)| {
+        let Some(row) = actual.as_object() else { return false };
+        let required = ["pitch", "start", "duration", "velocity"];
+        required.iter().all(|key| actual[*key].as_f64() == expected[*key].as_f64())
+            && actual.get("mute").is_none_or(|value| value == false)
+            && row.iter().all(|(key, value)| match key.as_str() {
+                "pitch" | "start" | "duration" | "velocity" | "mute" => true,
+                "probability" => value.as_f64() == Some(1.0),
+                "velocityDeviation" => value.as_f64() == Some(0.0),
+                "releaseVelocity" => value.as_f64() == Some(64.0),
+                "channel" => value.as_f64() == Some(0.0),
+                _ => false,
+            })
+    })
+}
