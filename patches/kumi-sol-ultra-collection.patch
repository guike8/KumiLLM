+fn preference(text: &str) -> bool {
+    let lowered = text.to_lowercase().replace('’', "'");
+    let words = lowered.split(|c: char| !c.is_alphanumeric() && c != '\'').filter(|word| !word.is_empty()).collect::<Vec<_>>();
+    let normalized = words.join(" ").replace("upper case", "uppercase").replace("all caps", "uppercase");
+    let negated = [
+        "not",
+        "never",
+        "don't",
+        "dont",
+        "doesn't",
+        "doesnt",
+        "no",
+        "avoid",
+        "dislike",
+        "dislikes",
+        "hate",
+        "hates",
+        "lowercase",
+        "lower",
+        "mixed",
+    ];
+    let affirmative = [
+        "names are uppercase",
+        "names should be uppercase",
+        "names to be uppercase",
+        "names in uppercase",
+        "uppercase track names",
+        "uppercase names for",
+        "prefers uppercase",
+        "prefer uppercase",
+        "uses uppercase",
+        "use uppercase",
+        "preference is uppercase",
+    ];
+    normalized.contains("track")
+        && affirmative.iter().any(|phrase| normalized.contains(phrase))
+        && !words.iter().any(|word| negated.contains(word))
+}
