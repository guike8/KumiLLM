+pub(super) async fn collect(directory: &Path, catalog: &Rc<ListToolsResult>, watched: &Rc<Watched>) -> Result<i32, RuntimeError> {
+    std::fs::create_dir(directory).map_err(failure)?;
+    let raw_directory = directory.join("raw");
+    std::fs::create_dir(&raw_directory).map_err(failure)?;
+    let limit =
+        std::env::var("KUMI_COLLECT_LIMIT").ok().map(|value| value.parse::<usize>().map_err(failure)).transpose()?.unwrap_or(96).min(96);
+    if limit == 0 {
+        return Err(RuntimeError::plain("KUMI_COLLECT_LIMIT must be positive."));
+    }
+    let mut completed = 0;
+    let mut passed = 0;
+    for family in 0..12 {
+        for variant in 0..8 {
+            if completed >= limit {
+                break;
+            }
+            let goal = Goal::new(family, variant);
+            ACTIVE.with(|active| *active.borrow_mut() = Some(goal.clone()));
+            VERIFICATION.with(|verification| *verification.borrow_mut() = Value::Null);
+            let model = Counted::new(teacher_binding());
+            let case = Case { prompts: Prompts::Naming(prompt_for_goal), ..said("collection compound task", &[], verify) };
+            let outcome = match run_case(&model, &case, catalog, watched).await {
+                Ok(outcome) => outcome,
+                Err(error) => Outcome { error: Some(safe_error(Some(&error), &[])), ..Outcome::default() },
+            };
+            passed += usize::from(outcome.passed);
+            completed += 1;
+            let record = json!({
+                "format_version":1, "episode_id":goal.episode_id, "project_id":goal.project_id,
+                "project_family_id":goal.project_family_id, "split":goal.split,
+                "scope":"executed_synthetic_kumi", "teacher":"scripted_oracle_v1",
+                "source_revision":"2ff07a5be515e0a267ea86f7c3d56fa579b607ea", "goals":goal,
+                "verification":VERIFICATION.with(|verification| verification.borrow().clone()),
+                "outcome":outcome, "calls":model.counting.capture.borrow().clone(),
+                "benchmark_cases_used":false, "created_at_ms":now_ms()
+            });
+            let path = raw_directory.join(format!("{}.json", goal.episode_id));
+            write_private(&path, &record).map_err(failure)?;
+            append_result(
+                &directory.join("progress.jsonl"),
+                &json!({"episode_id":goal.episode_id,"split":goal.split,"predicate_passed":outcome.passed,"error":outcome.error,"completed":completed}),
+            )?;
+            println!("collected {completed}/{limit}: {} predicate={}", goal.episode_id, outcome.passed);
+        }
+    }
+    ACTIVE.with(|active| *active.borrow_mut() = None);
+    let manifest = json!({"format_version":1,"completed_episodes":completed,"predicate_passed_episodes":passed,
+        "status":"raw_collection_complete_pending_strict_admission", "scope":"executed_synthetic_kumi",
+        "teacher":"scripted_oracle_v1","real_live_verified":false,"audio_quality_verified":false,
+        "benchmark_cases_used":false,"split_rule":"entire seed groups: train 00-07; valid 08-09; test 10-11",
+        "limitations":["Four scripted task templates share one project layout; groups vary names and values, not task or layout structure.","Set-memory examples verify a queued note for an unsaved Set, not persistence after saving.","No real Live operation or audio quality was verified."]});
+    write_private(&directory.join("collection.json"), &manifest).map_err(failure)?;
+    println!("{}", stringify(&manifest));
+    Ok(if passed == completed { 0 } else { 1 })
+}
