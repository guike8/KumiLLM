+#[async_trait(?Send)]
+impl LanguageModel for Teacher {
+    async fn do_stream(&self, options: CallOptions) -> Result<StreamParts, LanguageModelError> {
+        let stage = self.stage.get();
+        self.stage.set(stage + 1);
+        if stage > 6 {
+            return Err(LanguageModelError::other("Scripted teacher exceeded its finite plan."));
+        }
+        let actions = self.calls(stage, &options)?;
+        let mut parts = vec![];
+        let reason = if actions.is_empty() {
+            parts.push(StreamPart::TextDelta {
+                id: "verified-answer".into(),
+                delta: if goal().kind == 3 {
+                    "Verified the requested level in a fresh readback. The song note is queued until this unsaved Set is saved; the other settings and transport were preserved."
+                } else {
+                    "Verified the requested changes in a fresh readback. The other settings and transport were preserved."
+                }.into(),
+                provider_metadata: None,
+            });
+            FinishReasonUnified::Stop
+        } else {
+            for (index, (name, input)) in actions.into_iter().enumerate() {
+                if !options.tools.as_ref().is_some_and(|tools| tools.iter().any(|tool| tool.name == name)) {
+                    return Err(LanguageModelError::other(format!("Teacher tool {name} was not supplied by Kumi.")));
+                }
+                parts.push(StreamPart::ToolCall(ToolCall {
+                    tool_call_id: format!("collection-s{stage}-c{index}"),
+                    tool_name: name,
+                    input: stringify(&input),
+                    provider_executed: None,
+                    dynamic: None,
+                    provider_metadata: None,
+                }));
+            }
+            FinishReasonUnified::ToolCalls
+        };
+        parts.push(StreamPart::Finish {
+            usage: Usage::default(),
+            finish_reason: FinishReason { unified: reason, raw: None },
+            provider_metadata: None,
+        });
+        Ok(Box::pin(futures::stream::iter(parts)))
+    }
+}
