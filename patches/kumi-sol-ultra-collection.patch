+    #[test]
+    fn undo_requires_the_requested_first_edit_target_and_fresh_readbacks() {
+        let before = json!({"tempo":120,"tracks":[{"name":"Pulse"},{"name":"Sub"},{"name":"Reed"}],"playing":false});
+        let mut first = before.clone();
+        first["tempo"] = json!(137.5);
+        first["tracks"][2]["name"] = json!("Halo");
+        let checkpoint = json!({"turn_index":0,"state":first,
+        "changes":[{"family":"tempo","state":"applied"},{"family":"rename","state":"applied"}],
+        "bridge_calls":[
+            {"name":"live_tempo_apply","arguments":{},"result":{}},
+            {"name":"live_object_rename_apply","arguments":{},"result":{}},
+            {"name":"live_discover","arguments":{"kind":"track"},"result":{"structuredContent":{"items":[{"ref":"5:track:2","name":"Halo"}]}}},
+            {"name":"live_discover","arguments":{"kind":"set"},"result":{"structuredContent":{"items":[{"tempo":137.5}]}}}
+        ]});
+        assert!(undo_first_turn_valid(&checkpoint, &before));
+        let mut wrong_target = checkpoint.clone();
+        wrong_target["state"]["tracks"][0]["name"] = json!("Halo");
+        wrong_target["state"]["tracks"][2]["name"] = json!("Reed");
+        assert!(!undo_first_turn_valid(&wrong_target, &before), "undoing a wrong-target rename can produce the same final state");
+        let mut wrong_name = checkpoint.clone();
+        wrong_name["state"]["tracks"][2]["name"] = json!("Other");
+        assert!(!undo_first_turn_valid(&wrong_name, &before));
+        let mut no_read = checkpoint.clone();
+        no_read["bridge_calls"].as_array_mut().unwrap().truncate(2);
+        assert!(!undo_first_turn_valid(&no_read, &before));
+        let mut old_read = checkpoint;
+        old_read["bridge_calls"].as_array_mut().unwrap().rotate_right(2);
+        assert!(!undo_first_turn_valid(&old_read, &before), "reads preceding the writes are not fresh evidence");
+    }
