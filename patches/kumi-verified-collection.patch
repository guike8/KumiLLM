+fn local_binding(env: &HashMap<String, String>, effort: Option<Effort>) -> Result<Option<ModelBinding>, RuntimeError> {
+    let base = env.get("EVAL_BASE_URL").filter(|value| !value.is_empty());
+    let model = env.get("EVAL_LOCAL_MODEL").filter(|value| !value.is_empty());
+    let (base, model) = match (base, model) {
+        (None, None) => return Ok(None),
+        (Some(base), Some(model)) => (base, model),
+        _ => return Err(RuntimeError::plain("Set both EVAL_BASE_URL and EVAL_LOCAL_MODEL for a local benchmark.")),
+    };
+    let parsed = url::Url::parse(base).map_err(failure)?;
+    let loopback = parsed.host_str().is_some_and(|host| matches!(host, "localhost" | "127.0.0.1" | "[::1]" | "::1"));
+    if !loopback
+        || !matches!(parsed.scheme(), "http" | "https")
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.query().is_some()
+        || parsed.fragment().is_some()
+    {
+        return Err(RuntimeError::plain("EVAL_BASE_URL must be an HTTP(S) loopback URL without credentials, query or fragment."));
+    }
+    let path = parsed.path().trim_end_matches('/');
+    let base_url = format!("{}{}", parsed.origin().ascii_serialization(), if path.is_empty() { "/v1" } else { path });
+    Ok(Some(
+        resolve_local_model(
+            LocalServer {
+                id: "benchmark-local".into(),
+                kind: LocalKind::OpenaiCompatible,
+                name: "Local benchmark".into(),
+                base_url,
+                api_key: None,
+                r#where: "on this computer (possibly through SSH)".into(),
+                format: None,
+            },
+            model.clone(),
+            LocalModelOptions { effort, ..Default::default() },
+        )
+        .into_binding(),
+    ))
+}
