+/// Find the middle of the complete interval that displays the requested label, matching the production script's
+/// two 64-step bisections. Unshown labels return their neighbours; they are never silently rounded into a change.
+fn resolve_mixer_label(label: Option<&Value>, lo: f64, hi: f64, show: fn(f64) -> String) -> Value {
+    let Some(label) = label.filter(|label| !label.is_null()) else { return Value::Null };
+    let ends = || json!({"near": [show(lo), show(hi)]});
+    let Some(key) = mixer_label_order(&js_string(Some(label))) else { return ends() };
+    let at = |value| mixer_label_order(&show(value)).expect("the synthetic mixer produces an ordered label");
+    if key < at(lo) || key > at(hi) {
+        return ends();
+    }
+    let first = if at(lo) == key {
+        lo
+    } else {
+        let (mut a, mut b) = (lo, hi);
+        for _ in 0..64 {
+            let mid = (a + b) / 2.0;
+            if at(mid) < key {
+                a = mid;
+            } else {
+                b = mid;
+            }
+        }
+        if at(b) != key {
+            return json!({"near": [show(a), show(b)]});
+        }
+        b
+    };
+    let top = if at(hi) == key {
+        hi
+    } else {
+        let (mut c, mut d) = (first, hi);
+        for _ in 0..64 {
+            let mid = (c + d) / 2.0;
+            if at(mid) == key {
+                c = mid;
+            } else {
+                d = mid;
+            }
+        }
+        c
+    };
+    let value = if first == lo && key == f64::NEG_INFINITY { lo } else { (first + top) / 2.0 };
+    json!({"value": value, "shown": show(value)})
 }
 
